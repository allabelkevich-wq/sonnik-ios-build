<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Вход через Apple. Обязателен по правилу 4.8, когда в приложении есть
	     сторонние входы. В сторовой сборке он единственный: Telegram и VK
	     рядом с App Store не существуют. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
